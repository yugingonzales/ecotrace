class _CalendarStrip extends StatelessWidget {
  const _CalendarStrip({required this.selectedDay, required this.onSelected});

  final int selectedDay;
  final ValueChanged<int> onSelected;

  @override
  Widget build(BuildContext context) {
    const days = [
      ('Fri', '5'),
      ('Sat', '6'),
      ('Sun', '7'),
      ('Mon', '8'),
      ('Tue', '9'),
    ];
    return Container(
      padding: const EdgeInsets.all(8),
      decoration: BoxDecoration(
        color: Colors.black.withValues(alpha: .2),
        borderRadius: BorderRadius.circular(16),
      ),
      child: Row(
        children: days
            .map(
              (day) => Expanded(
                child: InkWell(
                  onTap: () => onSelected(int.parse(day.$2)),
                  borderRadius: BorderRadius.circular(12),
                  child: Container(
                    padding: const EdgeInsets.symmetric(vertical: 8),
                    margin: const EdgeInsets.symmetric(horizontal: 2),
                    decoration: BoxDecoration(
                      color: int.parse(day.$2) == selectedDay
                          ? EcoTraceColors.lemon
                          : Colors.transparent,
                      borderRadius: BorderRadius.circular(12),
                    ),
                    child: Column(
                      children: [
                        Text(
                          day.$1,
                          style: TextStyle(
                            color: int.parse(day.$2) == selectedDay
                                ? const Color(0xFF0A231C)
                                : const Color(0xFFA3B8AC),
                            fontSize: 9,
                            fontWeight: FontWeight.w800,
                          ),
                        ),
                        const SizedBox(height: 2),
                        Text(
                          day.$2,
                          style: TextStyle(
                            color: int.parse(day.$2) == selectedDay
                                ? const Color(0xFF0A231C)
                                : Colors.white,
                            fontSize: 14,
                            fontWeight: FontWeight.w900,
                          ),
                        ),
                      ],
                    ),
                  ),
                ),
              ),
            )
            .toList(),
      ),
    );
  }
}

